# This project calls Claude through Netlify's AI Gateway, which injects
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL automatically once the site is
# deployed to Netlify with at least one production deploy — no key needed here.
#
# Only set this if you want the chat function to call Anthropic directly
# instead of going through AI Gateway (e.g. running against your own
# Anthropic account/key). If set, Netlify will not override it.
ANTHROPIC_API_KEY=
